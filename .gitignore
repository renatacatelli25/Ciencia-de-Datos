# --- Proyecto: bases vectoriales Chroma ---
# Solo ignoramos índices experimentales o duplicados.
# SÍ subir chroma_db_productos_openai/ → índice final del agente (~6 MB).
chroma_db/
chroma_db_local/
chroma_db_final/
chroma_db_productos/

# --- Proyecto: datos y checkpoints ---
# Reviews.csv se versiona con Git LFS (ver .gitattributes).
src/data/*.csv
!src/data/Reviews.csv
src/data/*.json
src/data/*.parquet

# Checkpoints útiles para no re-ejecutar APIs ni procesamiento:
#   descripciones_checkpoint.csv  → descripciones generadas (usa agent.py)
#   product_names_checkpoint.csv    → nombres inferidos de productos
# Solo ignoramos archivos de validación intermedia:
descripciones_validacion.csv

# --- Proyecto: archivos generados / temporales ---
utils.zip
tmp_*.py
*.log
*.tmp
*.temp
results/agent_eval_*.csv
results/agent_eval_summary_*.json

