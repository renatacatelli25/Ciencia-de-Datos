# Backend del chat Streamlit: mock | local | api | rag
# - mock: respuestas simuladas (sin dependencias extra)
# - local / rag: agente RAG con sentence-transformers (sin OpenAI)
# - api: agente RAG con OpenAI
CHAT_BACKEND=mock

# Solo necesario en CHAT_BACKEND=api (o evaluación --mode api)
OPENAI_API_KEY=sk-tu-clave-aqui

# Modo del agente cuando CHAT_BACKEND=rag (local | api)
AGENT_MODE=local
